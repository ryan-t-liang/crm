generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum JobStatus {
  PENDING
  UPLOADED
  PREFLIGHT_READY
  READY_TO_EXECUTE
  PROCESSING
  COMPLETED
  COMPLETED_WITH_ERRORS
  PARTIAL
  FAILED
}

enum CrmContactStage {
  INITIAL
  ONE_TO_ONE
  SOLUTION
  CONVENTION
}

enum ContactType {
  BUSINESS
  INDIVIDUAL
}

enum CrmLeadPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum CrmLeadStatus {
  NEW
  QUALIFIED
  SOLUTION
  QUOTATION
  WON
  LOST
}

enum MarketingLeadStatus {
  NEW
  NURTURING
  MQL
  SQL
  QUALIFIED
  CONVERTED
  RECYCLED
  DISQUALIFIED
}

enum LeadScoreDimension {
  FIT
  ENGAGEMENT
}

enum LeadActivitySource {
  WEB
  CRM
  SYSTEM
  IMPORT
  CAMPAIGN
  EVENT
}

enum CrmFollowupType {
  GENERAL
  MEETING
  CALL
  EMAIL
  WECHAT
  OTHER
}

enum CrmAttachmentKind {
  IMAGE
  VIDEO
  DOCUMENT
}

enum CrmAttachmentEntityType {
  ORGANIZATION
  CONTACT
  CONTACT_FOLLOWUP
  LEAD
  LEAD_FOLLOWUP
}

enum OrganizationRoleType {
  PROSPECT
  CUSTOMER
  VENDOR
  PARTNER
}

enum OrganizationLifecycle {
  TARGET
  CONTACTED
  NURTURING
  OPPORTUNITY
  CUSTOMER
  DISQUALIFIED
}

enum OrganizationNurtureStatus {
  ACTIVE
  PAUSED
  COMPLETED
}

enum CrmTaskStatus {
  OPEN
  DONE
  CANCELED
}

enum CrmTaskPriority {
  NORMAL
  HIGH
}

enum CrmTaskSource {
  MANUAL
  FOLLOWUP
  NURTURE
}

enum CrmAttachmentStorageType {
  LOCAL
  EXTERNAL_URL
}

enum AssignmentNotificationStatus {
  PENDING
  SENT
  FAILED
}

model Role {
  id          String           @id @default(cuid()) @db.VarChar(32)
  key         String           @unique @db.VarChar(64)
  name        String           @db.VarChar(120)
  description String?          @db.VarChar(500)
  system      Boolean          @default(false)
  createdAt   DateTime         @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.DateTime(3)
  users       User[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String           @id @default(cuid()) @db.VarChar(32)
  key         String           @unique @db.VarChar(120)
  name        String           @db.VarChar(120)
  module      String           @db.VarChar(64)
  description String?          @db.VarChar(500)
  createdAt   DateTime         @default(now()) @map("created_at") @db.DateTime(3)
  roles       RolePermission[]

  @@index([module])
  @@map("permissions")
}

model RolePermission {
  roleId       String     @map("role_id") @db.VarChar(32)
  permissionId String     @map("permission_id") @db.VarChar(32)
  createdAt    DateTime   @default(now()) @map("created_at") @db.DateTime(3)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model User {
  id                      String                         @id @default(cuid()) @db.VarChar(32)
  name                    String                         @db.VarChar(120)
  loginAccount            String                         @unique @map("login_account") @db.VarChar(191)
  passwordHash            String                         @map("password_hash") @db.VarChar(255)
  status                  UserStatus                     @default(ACTIVE)
  mustChangePassword      Boolean                        @default(true) @map("must_change_password")
  passwordChangedAt       DateTime?                      @map("password_changed_at") @db.DateTime(3)
  lastLoginAt             DateTime?                      @map("last_login_at") @db.DateTime(3)
  failedLoginCount        Int                            @default(0) @map("failed_login_count")
  lockedUntil             DateTime?                      @map("locked_until") @db.DateTime(3)
  roleId                  String                         @map("role_id") @db.VarChar(32)
  createdAt               DateTime                       @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt               DateTime                       @updatedAt @map("updated_at") @db.DateTime(3)
  role                    Role                           @relation(fields: [roleId], references: [id], onDelete: Restrict)
  sessions                Session[]
  ownedContacts           Contact[]                      @relation("ContactOwner")
  createdContacts         Contact[]                      @relation("ContactCreatedBy")
  deletedContacts         Contact[]                      @relation("ContactDeletedBy")
  ownedContactFollowups   ContactFollowup[]              @relation("ContactFollowupOwner")
  createdContactFollowups ContactFollowup[]              @relation("ContactFollowupCreatedBy")
  salesOwnedCrmLeads      CrmLead[]                      @relation("CrmLeadSalesOwner")
  followupOwnedCrmLeads   CrmLead[]                      @relation("CrmLeadFollowupOwner")
  createdCrmLeads         CrmLead[]                      @relation("CrmLeadCreatedBy")
  deletedCrmLeads         CrmLead[]                      @relation("CrmLeadDeletedBy")
  ownedLeadFollowups      LeadFollowup[]                 @relation("LeadFollowupOwner")
  createdLeadFollowups    LeadFollowup[]                 @relation("LeadFollowupCreatedBy")
  leadParticipations      CrmLeadParticipant[]           @relation("CrmLeadParticipantUser")
  uploadedCrmAttachments  CrmAttachment[]                @relation("CrmAttachmentUploadedBy")
  ownedOrganizations      Organization[]                 @relation("OrganizationOwner")
  createdOrganizations    Organization[]                 @relation("OrganizationCreatedBy")
  deletedOrganizations    Organization[]                 @relation("OrganizationDeletedBy")
  ownedNurtures           OrganizationNurture[]          @relation("OrganizationNurtureOwner")
  createdNurtures         OrganizationNurture[]          @relation("OrganizationNurtureCreatedBy")
  ownedCrmTasks           CrmTask[]                      @relation("CrmTaskOwner")
  createdCrmTasks         CrmTask[]                      @relation("CrmTaskCreatedBy")
  completedCrmTasks       CrmTask[]                      @relation("CrmTaskCompletedBy")
  leadStageChanges        LeadStageHistory[]             @relation("LeadStageChangedBy")
  lifecycleChanges        OrganizationLifecycleHistory[] @relation("OrganizationLifecycleChangedBy")
  ownedMarketingLeads     MarketingLead[]                @relation("MarketingLeadOwner")
  createdMarketingLeads   MarketingLead[]                @relation("MarketingLeadCreatedBy")
  deletedMarketingLeads   MarketingLead[]                @relation("MarketingLeadDeletedBy")
  convertedMarketingLeads MarketingLead[]                @relation("MarketingLeadConvertedBy")
  marketingLeadActivities LeadActivityEvent[]            @relation("LeadActivityActor")
  marketingScoreChanges   LeadScoreHistory[]             @relation("LeadScoreChangedBy")
  marketingStatusChanges  LeadStatusHistory[]            @relation("LeadStatusChangedBy")
  assignmentNotifications AssignmentNotification[]       @relation("AssignmentNotificationRecipient")
  assignedNotifications   AssignmentNotification[]       @relation("AssignmentNotificationActor")

  @@index([status])
  @@map("users")
}

model Session {
  id         String    @id @default(cuid()) @db.VarChar(32)
  userId     String    @map("user_id") @db.VarChar(32)
  tokenHash  String    @unique @map("token_hash") @db.Char(64)
  expiresAt  DateTime  @map("expires_at") @db.DateTime(3)
  revokedAt  DateTime? @map("revoked_at") @db.DateTime(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  lastSeenAt DateTime  @default(now()) @map("last_seen_at") @db.DateTime(3)
  ipAddress  String?   @map("ip_address") @db.VarChar(64)
  userAgent  String?   @map("user_agent") @db.VarChar(500)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([revokedAt])
  @@map("auth_sessions")
}

model AuditLog {
  id          String   @id @default(cuid()) @db.VarChar(32)
  actorUserId String?  @map("actor_user_id") @db.VarChar(32)
  actorName   String   @map("actor_name") @db.VarChar(120)
  action      String   @db.VarChar(100)
  module      String   @db.VarChar(64)
  targetType  String   @map("target_type") @db.VarChar(64)
  targetId    String?  @map("target_id") @db.VarChar(64)
  details     Json?
  ipAddress   String?  @map("ip_address") @db.VarChar(64)
  requestId   String?  @map("request_id") @db.VarChar(64)
  userAgent   String?  @map("user_agent") @db.VarChar(500)
  traceId     String?  @map("trace_id") @db.VarChar(64)
  createdAt   DateTime @default(now()) @map("created_at") @db.DateTime(3)

  @@index([createdAt])
  @@index([actorUserId, createdAt])
  @@index([module, createdAt])
  @@index([traceId])
  @@index([targetType, targetId])
  @@map("audit_logs")
}

model Contact {
  id                      String            @id @default(cuid()) @db.VarChar(32)
  contactName             String            @map("contact_name") @db.VarChar(160)
  contactType             ContactType       @default(BUSINESS) @map("contact_type")
  companyShortName        String?           @map("company_short_name") @db.VarChar(120)
  companyName             String?           @map("company_name") @db.VarChar(240)
  department              String?           @db.VarChar(160)
  title                   String?           @db.VarChar(160)
  email                   String?           @db.VarChar(191)
  phone                   String?           @db.VarChar(64)
  phoneNormalized         String?           @map("phone_normalized") @db.VarChar(32)
  whatsapp                String?           @db.VarChar(64)
  whatsappNormalized      String?           @map("whatsapp_normalized") @db.VarChar(32)
  wechat                  String?           @db.VarChar(191)
  linkedin                String?           @db.VarChar(500)
  website                 String?           @db.VarChar(500)
  industry                String?           @db.VarChar(160)
  source                  String?           @db.VarChar(160)
  country                 String?           @db.VarChar(120)
  city                    String?           @db.VarChar(120)
  region                  String?           @db.VarChar(120)
  stage                   CrmContactStage   @default(INITIAL)
  ownerUserId             String?           @map("owner_user_id") @db.VarChar(32)
  nextFollowupAt          DateTime?         @map("next_followup_at") @db.DateTime(3)
  initialContext          String?           @map("initial_context") @db.Text
  followupAttention       String?           @map("followup_attention") @db.Text
  remark                  String?           @db.Text
  createdAt               DateTime          @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt               DateTime          @updatedAt @map("updated_at") @db.DateTime(3)
  createdByUserId         String            @map("created_by_user_id") @db.VarChar(32)
  deletedAt               DateTime?         @map("deleted_at") @db.DateTime(3)
  deletedByUserId         String?           @map("deleted_by_user_id") @db.VarChar(32)
  organizationId          String?           @map("organization_id") @db.VarChar(32)
  owner                   User?             @relation("ContactOwner", fields: [ownerUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdBy               User              @relation("ContactCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  deletedBy               User?             @relation("ContactDeletedBy", fields: [deletedByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  organization            Organization?     @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  followups               ContactFollowup[]
  leads                   CrmLead[]
  tasks                   CrmTask[]
  convertedMarketingLeads MarketingLead[]   @relation("MarketingLeadConvertedContact")

  @@index([stage, updatedAt])
  @@index([ownerUserId, updatedAt])
  @@index([nextFollowupAt])
  @@index([deletedAt, updatedAt])
  @@index([deletedByUserId])
  @@index([organizationId, updatedAt])
  @@index([contactType, updatedAt])
  @@index([phoneNormalized])
  @@index([whatsappNormalized])
  @@map("contacts")
}

model ContactFollowup {
  id              String          @id @default(cuid()) @db.VarChar(32)
  contactId       String          @map("contact_id") @db.VarChar(32)
  occurredAt      DateTime        @map("occurred_at") @db.DateTime(3)
  ownerUserId     String          @map("owner_user_id") @db.VarChar(32)
  type            CrmFollowupType @default(GENERAL)
  content         String          @db.Text
  nextAction      String?         @map("next_action") @db.Text
  nextFollowupAt  DateTime?       @map("next_followup_at") @db.DateTime(3)
  createdAt       DateTime        @default(now()) @map("created_at") @db.DateTime(3)
  createdByUserId String          @map("created_by_user_id") @db.VarChar(32)
  contact         Contact         @relation(fields: [contactId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  owner           User            @relation("ContactFollowupOwner", fields: [ownerUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdBy       User            @relation("ContactFollowupCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([contactId, occurredAt])
  @@index([contactId, nextFollowupAt])
  @@map("contact_followups")
}

model CrmLead {
  id                         String               @id @default(cuid()) @db.VarChar(32)
  contactId                  String               @map("contact_id") @db.VarChar(32)
  requirementSummary         String               @map("requirement_summary") @db.VarChar(200)
  requirementDetail          String?              @map("requirement_detail") @db.Text
  requirementContext         String?              @map("requirement_context") @db.VarChar(160)
  productInterest            String?              @map("product_interest") @db.Text
  requirementTags            Json?                @map("requirement_tags")
  latestProgress             String?              @map("latest_progress") @db.Text
  nextAction                 String?              @map("next_action") @db.Text
  imageRequirementNote       String?              @map("image_requirement_note") @db.Text
  quotationNote              String?              @map("quotation_note") @db.Text
  leadSource                 String?              @map("lead_source") @db.VarChar(160)
  priority                   CrmLeadPriority      @default(MEDIUM)
  estimatedQuote             Decimal?             @map("estimated_quote") @db.Decimal(18, 2)
  currency                   String?              @db.Char(3)
  projectDomain              String?              @map("project_domain") @db.VarChar(160)
  projectType                String?              @map("project_type") @db.VarChar(160)
  technologyType             String?              @map("technology_type") @db.Text
  productType                String?              @map("product_type") @db.VarChar(160)
  productName                String?              @map("product_name") @db.VarChar(240)
  resourceRequirement        String?              @map("resource_requirement") @db.Text
  collaborationGroups        String?              @map("collaboration_groups") @db.Text
  followMode                 String?              @map("follow_mode") @db.VarChar(160)
  solution                   String?              @db.Text
  remark                     String?              @db.Text
  status                     CrmLeadStatus        @default(NEW)
  salesOwnerUserId           String?              @map("sales_owner_user_id") @db.VarChar(32)
  followupOwnerUserId        String?              @map("followup_owner_user_id") @db.VarChar(32)
  nextFollowupAt             DateTime?            @map("next_followup_at") @db.DateTime(3)
  lastFollowupAt             DateTime?            @map("last_followup_at") @db.DateTime(3)
  wonAt                      DateTime?            @map("won_at") @db.DateTime(3)
  closedAt                   DateTime?            @map("closed_at") @db.DateTime(3)
  deliveryFollowupAt         DateTime?            @map("delivery_followup_at") @db.DateTime(3)
  contractRenewalAt          DateTime?            @map("contract_renewal_at") @db.DateTime(3)
  paymentReceivedAt          DateTime?            @map("payment_received_at") @db.DateTime(3)
  createdAt                  DateTime             @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt                  DateTime             @updatedAt @map("updated_at") @db.DateTime(3)
  createdByUserId            String               @map("created_by_user_id") @db.VarChar(32)
  deletedAt                  DateTime?            @map("deleted_at") @db.DateTime(3)
  deletedByUserId            String?              @map("deleted_by_user_id") @db.VarChar(32)
  sourceMarketingLeadId      String?              @unique @map("source_marketing_lead_id") @db.VarChar(32)
  contact                    Contact              @relation(fields: [contactId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  sourceMarketingLead        MarketingLead?       @relation("OpportunitySourceMarketingLead", fields: [sourceMarketingLeadId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  convertedFromMarketingLead MarketingLead?       @relation("MarketingLeadConvertedOpportunity")
  salesOwner                 User?                @relation("CrmLeadSalesOwner", fields: [salesOwnerUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  followupOwner              User?                @relation("CrmLeadFollowupOwner", fields: [followupOwnerUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdBy                  User                 @relation("CrmLeadCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  deletedBy                  User?                @relation("CrmLeadDeletedBy", fields: [deletedByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  followups                  LeadFollowup[]
  participants               CrmLeadParticipant[]
  stageHistory               LeadStageHistory[]
  tasks                      CrmTask[]

  @@index([contactId, updatedAt])
  @@index([status, updatedAt])
  @@index([priority, updatedAt])
  @@index([salesOwnerUserId, updatedAt])
  @@index([followupOwnerUserId, updatedAt])
  @@index([nextFollowupAt])
  @@index([lastFollowupAt])
  @@index([wonAt])
  @@index([closedAt])
  @@index([deletedAt, updatedAt])
  @@index([deletedByUserId])
  @@map("crm_leads")
}

model LeadFollowup {
  id              String          @id @default(cuid()) @db.VarChar(32)
  leadId          String          @map("lead_id") @db.VarChar(32)
  occurredAt      DateTime        @map("occurred_at") @db.DateTime(3)
  ownerUserId     String          @map("owner_user_id") @db.VarChar(32)
  type            CrmFollowupType @default(GENERAL)
  content         String          @db.Text
  progress        String?         @db.Text
  nextAction      String?         @map("next_action") @db.Text
  nextFollowupAt  DateTime?       @map("next_followup_at") @db.DateTime(3)
  important       Boolean         @default(false)
  createdAt       DateTime        @default(now()) @map("created_at") @db.DateTime(3)
  createdByUserId String          @map("created_by_user_id") @db.VarChar(32)
  lead            CrmLead         @relation(fields: [leadId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  owner           User            @relation("LeadFollowupOwner", fields: [ownerUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdBy       User            @relation("LeadFollowupCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([leadId, occurredAt])
  @@index([leadId, nextFollowupAt])
  @@map("lead_followups")
}

model CrmLeadParticipant {
  leadId    String   @map("lead_id") @db.VarChar(32)
  userId    String   @map("user_id") @db.VarChar(32)
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  lead      CrmLead  @relation(fields: [leadId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  user      User     @relation("CrmLeadParticipantUser", fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@id([leadId, userId])
  @@index([userId, createdAt])
  @@map("crm_lead_participants")
}

model MarketingLead {
  id                          String              @id @default(cuid()) @db.VarChar(32)
  fullName                    String              @map("full_name") @db.VarChar(160)
  email                       String?             @db.VarChar(191)
  phone                       String?             @db.VarChar(64)
  phoneNormalized             String?             @map("phone_normalized") @db.VarChar(32)
  whatsapp                    String?             @db.VarChar(64)
  whatsappNormalized          String?             @map("whatsapp_normalized") @db.VarChar(32)
  wechat                      String?             @db.VarChar(191)
  linkedinUrl                 String?             @map("linkedin_url") @db.VarChar(500)
  title                       String?             @db.VarChar(160)
  department                  String?             @db.VarChar(160)
  companyName                 String?             @map("company_name") @db.VarChar(240)
  companyWebsite              String?             @map("company_website") @db.VarChar(500)
  companyDomain               String?             @map("company_domain") @db.VarChar(191)
  companySize                 String?             @map("company_size") @db.VarChar(80)
  industry                    String?             @db.VarChar(160)
  countryCode                 String?             @map("country_code") @db.Char(2)
  region                      String?             @db.VarChar(120)
  city                        String?             @db.VarChar(120)
  inquiryType                 String?             @map("inquiry_type") @db.VarChar(160)
  inquiryContent              String?             @map("inquiry_content") @db.Text
  productInterest             String?             @map("product_interest") @db.Text
  requirementTags             Json?               @map("requirement_tags")
  budgetRange                 String?             @map("budget_range") @db.VarChar(160)
  note                        String?             @db.Text
  source                      String              @db.VarChar(40)
  sourceChannel               String?             @map("source_channel") @db.VarChar(120)
  sourceDetail                String?             @map("source_detail") @db.VarChar(240)
  firstTouchAt                DateTime?           @map("first_touch_at") @db.DateTime(3)
  status                      MarketingLeadStatus @default(NEW)
  ownerUserId                 String?             @map("owner_user_id") @db.VarChar(32)
  assignedAt                  DateTime?           @map("assigned_at") @db.DateTime(3)
  mqlAt                       DateTime?           @map("mql_at") @db.DateTime(3)
  sqlAt                       DateTime?           @map("sql_at") @db.DateTime(3)
  qualifiedAt                 DateTime?           @map("qualified_at") @db.DateTime(3)
  recycledAt                  DateTime?           @map("recycled_at") @db.DateTime(3)
  convertedAt                 DateTime?           @map("converted_at") @db.DateTime(3)
  disqualifiedAt              DateTime?           @map("disqualified_at") @db.DateTime(3)
  disqualifiedReason          String?             @map("disqualified_reason") @db.Text
  fitScore                    Int                 @default(0) @map("fit_score") @db.UnsignedTinyInt
  fitReason                   String?             @map("fit_reason") @db.Text
  engagementScoreCached       Int                 @default(0) @map("engagement_score_cached") @db.UnsignedTinyInt
  engagementScoreCalculatedAt DateTime?           @map("engagement_score_calculated_at") @db.DateTime(3)
  lastActivityAt              DateTime?           @map("last_activity_at") @db.DateTime(3)
  firstSalesResponseAt        DateTime?           @map("first_sales_response_at") @db.DateTime(3)
  convertedOrganizationId     String?             @map("converted_organization_id") @db.VarChar(32)
  convertedContactId          String?             @map("converted_contact_id") @db.VarChar(32)
  convertedOpportunityId      String?             @unique @map("converted_opportunity_id") @db.VarChar(32)
  convertedByUserId           String?             @map("converted_by_user_id") @db.VarChar(32)
  createdByUserId             String              @map("created_by_user_id") @db.VarChar(32)
  createdAt                   DateTime            @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt                   DateTime            @updatedAt @map("updated_at") @db.DateTime(3)
  deletedAt                   DateTime?           @map("deleted_at") @db.DateTime(3)
  deletedByUserId             String?             @map("deleted_by_user_id") @db.VarChar(32)
  owner                       User?               @relation("MarketingLeadOwner", fields: [ownerUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdBy                   User                @relation("MarketingLeadCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  deletedBy                   User?               @relation("MarketingLeadDeletedBy", fields: [deletedByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  convertedBy                 User?               @relation("MarketingLeadConvertedBy", fields: [convertedByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  convertedOrganization       Organization?       @relation("MarketingLeadConvertedOrganization", fields: [convertedOrganizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  convertedContact            Contact?            @relation("MarketingLeadConvertedContact", fields: [convertedContactId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  convertedOpportunity        CrmLead?            @relation("MarketingLeadConvertedOpportunity", fields: [convertedOpportunityId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  sourcedOpportunity          CrmLead?            @relation("OpportunitySourceMarketingLead")
  activities                  LeadActivityEvent[]
  scoreHistory                LeadScoreHistory[]
  statusHistory               LeadStatusHistory[]

  @@index([status, createdAt])
  @@index([ownerUserId, status, updatedAt])
  @@index([source, createdAt])
  @@index([email])
  @@index([phoneNormalized])
  @@index([whatsappNormalized])
  @@index([companyDomain])
  @@index([convertedOrganizationId])
  @@index([convertedContactId])
  @@index([convertedByUserId])
  @@index([deletedAt, updatedAt])
  @@map("marketing_leads")
}

model LeadScoringRule {
  id             String              @id @default(cuid()) @db.VarChar(32)
  code           String              @unique @db.VarChar(80)
  name           String              @db.VarChar(160)
  category       String              @db.VarChar(80)
  scoreDimension LeadScoreDimension  @map("score_dimension")
  scoreDelta     Int                 @map("score_delta") @db.SmallInt
  repeatable     Boolean             @default(true)
  maxOccurrences Int?                @map("max_occurrences") @db.UnsignedSmallInt
  cooldownHours  Int?                @map("cooldown_hours") @db.UnsignedSmallInt
  enabled        Boolean             @default(true)
  sortOrder      Int                 @default(0) @map("sort_order")
  description    String?             @db.VarChar(500)
  createdAt      DateTime            @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime            @updatedAt @map("updated_at") @db.DateTime(3)
  activities     LeadActivityEvent[]

  @@index([enabled, sortOrder])
  @@index([scoreDimension, enabled])
  @@map("lead_scoring_rules")
}

model LeadActivityEvent {
  id                      String             @id @default(cuid()) @db.VarChar(32)
  marketingLeadId         String             @map("marketing_lead_id") @db.VarChar(32)
  scoringRuleId           String?            @map("scoring_rule_id") @db.VarChar(32)
  eventType               String             @map("event_type") @db.VarChar(80)
  source                  LeadActivitySource
  occurredAt              DateTime           @map("occurred_at") @db.DateTime(3)
  actorUserId             String?            @map("actor_user_id") @db.VarChar(32)
  note                    String?            @db.Text
  engagementDeltaSnapshot Int                @default(0) @map("engagement_delta_snapshot") @db.SmallInt
  fitDeltaSnapshot        Int                @default(0) @map("fit_delta_snapshot") @db.SmallInt
  createdAt               DateTime           @default(now()) @map("created_at") @db.DateTime(3)
  marketingLead           MarketingLead      @relation(fields: [marketingLeadId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  scoringRule             LeadScoringRule?   @relation(fields: [scoringRuleId], references: [id], onDelete: Restrict, onUpdate: Cascade)
