}

model CrmTask {
  id                String          @id @default(cuid()) @db.VarChar(32)
  organizationId    String?         @map("organization_id") @db.VarChar(32)
  contactId         String?         @map("contact_id") @db.VarChar(32)
  leadId            String?         @map("lead_id") @db.VarChar(32)
  title             String          @db.VarChar(300)
  description       String?         @db.Text
  ownerUserId       String          @map("owner_user_id") @db.VarChar(32)
  priority          CrmTaskPriority @default(NORMAL)
  dueAt             DateTime        @map("due_at") @db.DateTime(3)
  status            CrmTaskStatus   @default(OPEN)
  source            CrmTaskSource   @default(MANUAL)
  completedAt       DateTime?       @map("completed_at") @db.DateTime(3)
  completedByUserId String?         @map("completed_by_user_id") @db.VarChar(32)
  createdByUserId   String          @map("created_by_user_id") @db.VarChar(32)
  createdAt         DateTime        @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt         DateTime        @updatedAt @map("updated_at") @db.DateTime(3)
  organization      Organization?   @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  contact           Contact?        @relation(fields: [contactId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  lead              CrmLead?        @relation(fields: [leadId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  owner             User            @relation("CrmTaskOwner", fields: [ownerUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdBy         User            @relation("CrmTaskCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  completedBy       User?           @relation("CrmTaskCompletedBy", fields: [completedByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([organizationId, status, dueAt])
  @@index([contactId, status, dueAt])
  @@index([leadId, status, dueAt])
  @@index([ownerUserId, status, dueAt])
  @@index([status, dueAt])
  @@index([source, createdAt])
  @@map("crm_tasks")
}

