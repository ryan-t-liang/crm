model ImportJob {
  id                  String         @id @default(cuid()) @db.VarChar(32)
  jobNo               String         @unique @map("job_no") @db.VarChar(80)
  objectType          String         @map("object_type") @db.VarChar(40)
  subtype             String?        @db.VarChar(80)
  fileName            String         @map("file_name") @db.VarChar(255)
  storagePath         String?        @map("storage_path") @db.VarChar(500)
  fileHash            String?        @map("file_hash") @db.Char(64)
  mappingJson         Json?          @map("mapping_json")
  resultJson          Json?          @map("result_json")
  conflictStrategy    String?        @map("conflict_strategy") @db.VarChar(40)
  unmatchedStrategy   String?        @map("unmatched_strategy") @db.VarChar(40)
  status              JobStatus      @default(PENDING)
  totalCount          Int            @default(0) @map("total_count")
  importableCount     Int            @default(0) @map("importable_count")
  successCount        Int            @default(0) @map("success_count")
  failedCount         Int            @default(0) @map("failed_count")
  skippedCount        Int            @default(0) @map("skipped_count")
  createdCount        Int            @default(0) @map("created_count")
  updatedCount        Int            @default(0) @map("updated_count")
  failureFilePath     String?        @map("failure_file_path") @db.VarChar(500)
  createdBy           String         @map("created_by") @db.VarChar(32)
  createdAt           DateTime       @default(now()) @map("created_at") @db.DateTime(3)
  preflightedAt       DateTime?      @map("preflighted_at") @db.DateTime(3)
  processingStartedAt DateTime?      @map("processing_started_at") @db.DateTime(3)
  completedAt         DateTime?      @map("completed_at") @db.DateTime(3)
  rows                ImportJobRow[]

  @@index([objectType, createdAt])
  @@index([createdBy, createdAt])
  @@index([objectType, fileHash])
  @@map("import_jobs")
}

model ImportJobRow {
  id             String    @id @default(cuid()) @db.VarChar(32)
  importJobId    String    @map("import_job_id") @db.VarChar(32)
  rowNumber      Int       @map("row_number")
  status         String    @db.VarChar(32)
  conflictType   String?   @map("conflict_type") @db.VarChar(64)
  identity       String?   @db.VarChar(191)
  rawData        Json      @map("raw_data")
  normalizedData Json?     @map("normalized_data")
  errors         Json?
  warnings       Json?
  createdId      String?   @map("created_id") @db.VarChar(32)
  createdAt      DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  importJob      ImportJob @relation(fields: [importJobId], references: [id], onDelete: Cascade)

  @@unique([importJobId, rowNumber])
  @@index([status])
  @@map("import_job_rows")
}

model ExportJob {
  id              String    @id @default(cuid()) @db.VarChar(32)
