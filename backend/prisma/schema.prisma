model Organization {
  id                      String                         @id @default(cuid()) @db.VarChar(32)
  name                    String                         @db.VarChar(240)
  normalizedName          String                         @map("normalized_name") @db.VarChar(240)
  shortName               String?                        @map("short_name") @db.VarChar(120)
  website                 String?                        @db.VarChar(500)
  websiteDomain           String?                        @map("website_domain") @db.VarChar(191)
  industry                String?                        @db.VarChar(160)
  industryCode            String?                        @map("industry_code") @db.VarChar(80)
  industryCustom          String?                        @map("industry_custom") @db.VarChar(160)
  country                 String?                        @db.VarChar(120)
  region                  String?                        @db.VarChar(120)
  city                    String?                        @db.VarChar(120)
  countryCode             String?                        @map("country_code") @db.Char(2)
  regionCode              String?                        @map("region_code") @db.VarChar(80)
  cityCode                String?                        @map("city_code") @db.VarChar(80)
  cityCustom              String?                        @map("city_custom") @db.VarChar(120)
  companySize             String?                        @map("company_size") @db.VarChar(80)
  ownerUserId             String?                        @map("owner_user_id") @db.VarChar(32)
  lifecycleStage          OrganizationLifecycle          @default(TARGET) @map("lifecycle_stage")
  fitScore                Int                            @default(0) @map("fit_score") @db.UnsignedTinyInt
  fitReason               String?                        @map("fit_reason") @db.Text
  note                    String?                        @db.Text
  createdByUserId         String                         @map("created_by_user_id") @db.VarChar(32)
  createdAt               DateTime                       @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt               DateTime                       @updatedAt @map("updated_at") @db.DateTime(3)
  deletedAt               DateTime?                      @map("deleted_at") @db.DateTime(3)
  deletedByUserId         String?                        @map("deleted_by_user_id") @db.VarChar(32)
  owner                   User?                          @relation("OrganizationOwner", fields: [ownerUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdBy               User                           @relation("OrganizationCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  deletedBy               User?                          @relation("OrganizationDeletedBy", fields: [deletedByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  roles                   OrganizationRole[]
  contacts                Contact[]
  nurtures                OrganizationNurture[]
  tasks                   CrmTask[]
  lifecycleHistory        OrganizationLifecycleHistory[]
  convertedMarketingLeads MarketingLead[]                @relation("MarketingLeadConvertedOrganization")

  @@index([normalizedName])
  @@index([websiteDomain])
  @@index([ownerUserId, updatedAt])
  @@index([lifecycleStage, updatedAt])
  @@index([industryCode, updatedAt])
  @@index([countryCode, regionCode, cityCode])
  @@index([fitScore, updatedAt])
  @@index([deletedAt, updatedAt])
  @@map("organizations")
}

model OrganizationRole {
  organizationId String               @map("organization_id") @db.VarChar(32)
