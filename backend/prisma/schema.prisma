  @@index([marketingLeadId, occurredAt])
  @@index([scoringRuleId, occurredAt])
  @@index([eventType, occurredAt])
  @@index([actorUserId, occurredAt])
  @@map("lead_activity_events")
}

model LeadScoreHistory {
