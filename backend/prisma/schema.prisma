}

model OrganizationNurture {
  id              String                    @id @default(cuid()) @db.VarChar(32)
  organizationId  String                    @map("organization_id") @db.VarChar(32)
  status          OrganizationNurtureStatus @default(ACTIVE)
  ownerUserId     String                    @map("owner_user_id") @db.VarChar(32)
  reason          String                    @db.Text
  objective       String                    @db.Text
  cadenceDays     Int                       @map("cadence_days") @db.UnsignedSmallInt
  nextTouchAt     DateTime                  @map("next_touch_at") @db.DateTime(3)
  touchTopic      String                    @map("touch_topic") @db.VarChar(300)
  startedAt       DateTime                  @default(now()) @map("started_at") @db.DateTime(3)
  endedAt         DateTime?                 @map("ended_at") @db.DateTime(3)
  createdByUserId String                    @map("created_by_user_id") @db.VarChar(32)
