generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum LeadSyncStatus {
  NOT_SYNCED
  SYNC_PENDING
  SYNCING
  GATEWAY_ACCEPTED
  SYNC_FAILED
  DEAD_LETTER
}

enum OutboxStatus {
  PENDING
  PROCESSING
  RETRY_WAITING
  SUCCEEDED
  FAILED
  DEAD_LETTER
}

enum JobStatus {
  PENDING
  UPLOADED
  PREFLIGHT_READY
  READY_TO_EXECUTE
  PROCESSING
  COMPLETED
  COMPLETED_WITH_ERRORS
  PARTIAL
  FAILED
}

enum CrmContactStage {
  INITIAL
  ONE_TO_ONE
  SOLUTION
  CONVENTION
}

enum CrmLeadPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum CrmLeadStatus {
  NEW
  QUALIFIED
  SOLUTION
  QUOTATION
  WON
  LOST
}

enum CrmFollowupType {
  GENERAL
  MEETING
  CALL
  EMAIL
  WECHAT
  OTHER
}

model Brand {
  id             String                  @id @default(cuid()) @db.VarChar(32)
  code           String                  @unique @db.VarChar(32)
  name           String                  @db.VarChar(120)
  shortName      String?                 @map("short_name") @db.VarChar(64)
  displayOrder   Int                     @default(0) @map("display_order")
  active         Boolean                 @default(true)
  themeConfig    Json?                   @map("theme_config")
  createdAt      DateTime                @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime                @updatedAt @map("updated_at") @db.DateTime(3)
  profiles       CustomerBrandProfile[]
  identities     CustomerIdentity[]
  consents       ConsentRecord[]
  leads          Lead[]
  hqLinks        CustomerHqLink[]
  outboxEvents   IntegrationOutbox[]
  forms          FormDefinition[]
  userAccess     UserBrandAccess[]
  importJobs     ImportJob[]
  exportJobs     ExportJob[]
  journeyEvents  CustomerJourneyEvent[]
  wechatContexts WechatIdentityContext[]

  @@map("brands")
}

model Role {
  id          String           @id @default(cuid()) @db.VarChar(32)
  key         String           @unique @db.VarChar(64)
  name        String           @db.VarChar(120)
  description String?          @db.VarChar(500)
  system      Boolean          @default(false)
  createdAt   DateTime         @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.DateTime(3)
  users       User[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String           @id @default(cuid()) @db.VarChar(32)
  key         String           @unique @db.VarChar(120)
  name        String           @db.VarChar(120)
  module      String           @db.VarChar(64)
  description String?          @db.VarChar(500)
  createdAt   DateTime         @default(now()) @map("created_at") @db.DateTime(3)
  roles       RolePermission[]

  @@index([module])
  @@map("permissions")
}

model RolePermission {
  roleId       String     @map("role_id") @db.VarChar(32)
  permissionId String     @map("permission_id") @db.VarChar(32)
  createdAt    DateTime   @default(now()) @map("created_at") @db.DateTime(3)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model User {
  id                      String            @id @default(cuid()) @db.VarChar(32)
  name                    String            @db.VarChar(120)
  loginAccount            String            @unique @map("login_account") @db.VarChar(191)
  passwordHash            String            @map("password_hash") @db.VarChar(255)
  status                  UserStatus        @default(ACTIVE)
  mustChangePassword      Boolean           @default(true) @map("must_change_password")
  passwordChangedAt       DateTime?         @map("password_changed_at") @db.DateTime(3)
  lastLoginAt             DateTime?         @map("last_login_at") @db.DateTime(3)
  failedLoginCount        Int               @default(0) @map("failed_login_count")
  lockedUntil             DateTime?         @map("locked_until") @db.DateTime(3)
  roleId                  String            @map("role_id") @db.VarChar(32)
  createdAt               DateTime          @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt               DateTime          @updatedAt @map("updated_at") @db.DateTime(3)
  role                    Role              @relation(fields: [roleId], references: [id], onDelete: Restrict)
  brandAccess             UserBrandAccess[]
  sessions                Session[]
  ownedContacts           Contact[]         @relation("ContactOwner")
  createdContacts         Contact[]         @relation("ContactCreatedBy")
  ownedContactFollowups   ContactFollowup[] @relation("ContactFollowupOwner")
  createdContactFollowups ContactFollowup[] @relation("ContactFollowupCreatedBy")
  salesOwnedCrmLeads      CrmLead[]         @relation("CrmLeadSalesOwner")
  followupOwnedCrmLeads   CrmLead[]         @relation("CrmLeadFollowupOwner")
  createdCrmLeads         CrmLead[]         @relation("CrmLeadCreatedBy")
  ownedLeadFollowups      LeadFollowup[]    @relation("LeadFollowupOwner")
  createdLeadFollowups    LeadFollowup[]    @relation("LeadFollowupCreatedBy")

  @@index([status])
  @@map("users")
}

model UserBrandAccess {
  userId    String   @map("user_id") @db.VarChar(32)
  brandId   String   @map("brand_id") @db.VarChar(32)
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  brand     Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@id([userId, brandId])
  @@index([brandId])
  @@map("user_brand_access")
}

model Session {
  id         String    @id @default(cuid()) @db.VarChar(32)
  userId     String    @map("user_id") @db.VarChar(32)
  tokenHash  String    @unique @map("token_hash") @db.Char(64)
  expiresAt  DateTime  @map("expires_at") @db.DateTime(3)
  revokedAt  DateTime? @map("revoked_at") @db.DateTime(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  lastSeenAt DateTime  @default(now()) @map("last_seen_at") @db.DateTime(3)
  ipAddress  String?   @map("ip_address") @db.VarChar(64)
  userAgent  String?   @map("user_agent") @db.VarChar(500)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([revokedAt])
  @@map("auth_sessions")
}

model Customer {
  id               String                  @id @default(cuid()) @db.VarChar(32)
  customerNo       String                  @unique @map("customer_no") @db.VarChar(64)
  displayName      String                  @map("display_name") @db.VarChar(160)
  mobile           String                  @db.VarChar(40)
  mobileNormalized String                  @unique @map("mobile_normalized") @db.VarChar(20)
  status           String                  @default("ACTIVE") @db.VarChar(32)
  createdBy        String?                 @map("created_by") @db.VarChar(32)
  createdAt        DateTime                @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt        DateTime                @updatedAt @map("updated_at") @db.DateTime(3)
  profiles         CustomerBrandProfile[]
  identities       CustomerIdentity[]
  consents         ConsentRecord[]
  leads            Lead[]
  notes            CustomerNote[]
  journeyEvents    CustomerJourneyEvent[]
  hqLinks          CustomerHqLink[]
  wechatContexts   WechatIdentityContext[]

  @@index([displayName])
  @@index([createdAt])
  @@map("customers")
}

model CustomerNumberSequence {
  id        BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)

  @@map("customer_number_sequences")
}

model CustomerBrandProfile {
  id                 String          @id @default(cuid()) @db.VarChar(32)
  customerId         String          @map("customer_id") @db.VarChar(32)
  brandId            String          @map("brand_id") @db.VarChar(32)
  brandMemberNo      String?         @map("brand_member_no") @db.VarChar(64)
  displayName        String?         @map("display_name") @db.VarChar(160)
  salutation         String?         @db.VarChar(40)
  lastName           String?         @map("last_name") @db.VarChar(100)
  firstName          String?         @map("first_name") @db.VarChar(100)
  birthday           DateTime?       @db.Date
  email              String?         @db.VarChar(191)
  mobile             String?         @db.VarChar(40)
  country            String?         @db.VarChar(100)
  region             String?         @db.VarChar(100)
  city               String?         @db.VarChar(100)
  postalCode         String?         @map("postal_code") @db.VarChar(32)
  addressLine        String?         @map("address_line") @db.VarChar(500)
  language           String?         @db.VarChar(64)
  preferredContact   String?         @map("preferred_contact") @db.VarChar(64)
  ownsBrandWatch     Boolean?        @map("owns_brand_watch")
  purchaseChannel    String?         @map("purchase_channel") @db.VarChar(120)
  interestCenter     String?         @map("interest_center") @db.VarChar(160)
  favoriteCollection String?         @map("favorite_collection") @db.VarChar(160)
  membershipStatus   String?         @default("REGISTERED") @map("membership_status") @db.VarChar(40)
  registrationSource String?         @map("registration_source") @db.VarChar(120)
  registeredAt       DateTime?       @map("registered_at") @db.DateTime(3)
  registrationData   Json?           @map("registration_data")
  openId             String?         @map("open_id") @db.VarChar(191)
  unionId            String?         @map("union_id") @db.VarChar(191)
  extraAttributes    Json?           @map("extra_attributes")
  createdAt          DateTime        @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt          DateTime        @updatedAt @map("updated_at") @db.DateTime(3)
  customer           Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  brand              Brand           @relation(fields: [brandId], references: [id], onDelete: Restrict)
  consents           ConsentRecord[]

  @@unique([customerId, brandId])
  @@unique([brandId, brandMemberNo])
  @@unique([brandId, openId])
  @@unique([brandId, unionId])
  @@index([brandId, registeredAt])
  @@index([email])
  @@map("customer_brand_profiles")
}

model CustomerIdentity {
  id           String    @id @default(cuid()) @db.VarChar(32)
  customerId   String    @map("customer_id") @db.VarChar(32)
  brandId      String    @map("brand_id") @db.VarChar(32)
  identityType String    @map("identity_type") @db.VarChar(40)
  scope        String    @db.VarChar(120)
  appId        String?   @map("app_id") @db.VarChar(120)
  value        String    @db.VarChar(512)
  verifiedAt   DateTime? @map("verified_at") @db.DateTime(3)
  source       String    @default("LEGACY_IDENTITY_MIGRATION") @db.VarChar(80)
  createdAt    DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.DateTime(3)
  customer     Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  brand        Brand     @relation(fields: [brandId], references: [id], onDelete: Restrict)

  @@unique([brandId, identityType, scope, value])
  @@index([customerId, brandId])
  @@map("customer_identities")
}

model WechatIdentityContext {
  id               String    @id @default(cuid()) @db.VarChar(32)
  tokenHash        String    @unique @map("token_hash") @db.Char(64)
  brandId          String    @map("brand_id") @db.VarChar(32)
  customerId       String?   @map("customer_id") @db.VarChar(32)
  appId            String    @map("app_id") @db.VarChar(120)
  appScope         String    @map("app_scope") @db.VarChar(160)
  mobileNormalized String    @map("mobile_normalized") @db.VarChar(20)
  openId           String?   @map("open_id") @db.VarChar(191)
  unionId          String?   @map("union_id") @db.VarChar(191)
  unionIdScope     String?   @map("union_id_scope") @db.VarChar(160)
  verifiedAt       DateTime  @map("verified_at") @db.DateTime(3)
  expiresAt        DateTime  @map("expires_at") @db.DateTime(3)
  createdAt        DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  lastSeenAt       DateTime  @default(now()) @map("last_seen_at") @db.DateTime(3)
  brand            Brand     @relation(fields: [brandId], references: [id], onDelete: Cascade)
  customer         Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([brandId, mobileNormalized])
  @@index([customerId, brandId])
  @@index([expiresAt])
  @@map("wechat_identity_contexts")
}

model ConsentRecord {
  id                     String                @id @default(cuid()) @db.VarChar(32)
  customerId             String?               @map("customer_id") @db.VarChar(32)
  leadId                 String?               @map("lead_id") @db.VarChar(32)
  customerBrandProfileId String?               @map("customer_brand_profile_id") @db.VarChar(32)
  brandId                String                @map("brand_id") @db.VarChar(32)
  purpose                String                @db.VarChar(100)
  channel                String                @db.VarChar(64)
  status                 String                @db.VarChar(32)
  policyVersion          String                @map("policy_version") @db.VarChar(120)
  termsVersion           String?               @map("terms_version") @db.VarChar(120)
  consentText            String?               @map("consent_text") @db.Text
  source                 String                @db.VarChar(80)
  capturedAt             DateTime              @map("captured_at") @db.DateTime(3)
  capturedBy             String?               @map("captured_by") @db.VarChar(32)
  evidence               Json?
  createdAt              DateTime              @default(now()) @map("created_at") @db.DateTime(3)
  customer               Customer?             @relation(fields: [customerId], references: [id], onDelete: Cascade)
  lead                   Lead?                 @relation(fields: [leadId], references: [id], onDelete: Cascade)
  customerBrandProfile   CustomerBrandProfile? @relation(fields: [customerBrandProfileId], references: [id], onDelete: Cascade)
  brand                  Brand                 @relation(fields: [brandId], references: [id], onDelete: Restrict)

  @@index([customerId, brandId, purpose, channel, capturedAt])
  @@index([leadId])
  @@index([customerBrandProfileId, purpose, channel, capturedAt])
  @@map("consent_records")
}

model FormDefinition {
  id            String   @id @default(cuid()) @db.VarChar(32)
  brandId       String   @map("brand_id") @db.VarChar(32)
  objectType    String   @map("object_type") @db.VarChar(40)
  formKey       String   @map("form_key") @db.VarChar(80)
  version       String   @db.VarChar(80)
  active        Boolean  @default(true)
  schemaJson    Json     @map("schema_json")
  policyVersion String?  @map("policy_version") @db.VarChar(120)
  termsVersion  String?  @map("terms_version") @db.VarChar(120)
  effectiveAt   DateTime @map("effective_at") @db.DateTime(3)
  createdAt     DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.DateTime(3)
  brand         Brand    @relation(fields: [brandId], references: [id], onDelete: Restrict)
  leads         Lead[]

  @@unique([brandId, objectType, formKey, version])
  @@index([brandId, objectType, active])
  @@map("form_definitions")
}

model Lead {
  id                String          @id @default(cuid()) @db.VarChar(32)
  leadNo            String          @unique @map("lead_no") @db.VarChar(80)
  brandId           String          @map("brand_id") @db.VarChar(32)
  customerId        String?         @map("customer_id") @db.VarChar(32)
  formDefinitionId  String?         @map("form_definition_id") @db.VarChar(32)
  leadType          String          @default("PURCHASE_INTENT") @map("lead_type") @db.VarChar(80)
  status            String          @default("NEW") @db.VarChar(40)
  ownerUserId       String?         @map("owner_user_id") @db.VarChar(32)
  source            String          @db.VarChar(80)
  submissionMode    String          @map("submission_mode") @db.VarChar(40)
  formVersion       String          @map("form_version") @db.VarChar(80)
  sku               String?         @db.VarChar(160)
  email             String          @db.VarChar(191)
  salutation        String          @db.VarChar(40)
  firstname         String          @db.VarChar(100)
  lastname          String          @db.VarChar(100)
  phone             String?         @db.VarChar(40)
  language          String          @default("zh") @db.VarChar(32)
  preferredContact  String          @map("preferred_contact") @db.VarChar(64)
  country           String          @db.VarChar(100)
  city              String?         @db.VarChar(100)
  ownership         String?         @db.VarChar(8)
  birthday          DateTime?       @db.Date
  purchaseMethod    String?         @map("purchase_method") @db.VarChar(120)
  retailer          String?         @db.VarChar(191)
  processingConsent Boolean         @map("processing_consent")
  marketingOptIn    Boolean         @default(false) @map("marketing_opt_in")
  attributes        Json
  originalSnapshot  Json?           @map("original_snapshot")
  syncStatus        LeadSyncStatus  @default(NOT_SYNCED) @map("sync_status")
  gatewayHttpStatus Int?            @map("gateway_http_status")
  gatewayRef        String?         @map("gateway_ref") @db.VarChar(191)
  retryCount        Int             @default(0) @map("retry_count")
  lastSyncError     String?         @map("last_error") @db.VarChar(1000)
  lastSyncedAt      DateTime?       @map("last_sync_at") @db.DateTime(3)
  idempotencyKey    String?         @unique @map("idempotency_key") @db.VarChar(191)
  createdBy         String?         @map("created_by_user_id") @db.VarChar(32)
  createdByService  String?         @map("created_by_service") @db.VarChar(120)
  createdAt         DateTime        @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt         DateTime        @updatedAt @map("updated_at") @db.DateTime(3)
  brand             Brand           @relation(fields: [brandId], references: [id], onDelete: Restrict)
  customer          Customer?       @relation(fields: [customerId], references: [id], onDelete: SetNull)
  formDefinition    FormDefinition? @relation(fields: [formDefinitionId], references: [id], onDelete: SetNull)
  consents          ConsentRecord[]

  @@index([brandId, createdAt])
  @@index([customerId])
  @@index([status])
  @@index([syncStatus])
  @@index([gatewayRef])
  @@map("leads")
}

model CustomerNote {
  id         String   @id @default(cuid()) @db.VarChar(32)
  customerId String   @map("customer_id") @db.VarChar(32)
  body       String   @db.Text
  createdBy  String   @map("created_by") @db.VarChar(32)
  createdAt  DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.DateTime(3)
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, createdAt])
  @@map("customer_notes")
}

model CustomerJourneyEvent {
  id          String   @id @default(cuid()) @db.VarChar(32)
  customerId  String   @map("customer_id") @db.VarChar(32)
  brandId     String?  @map("brand_id") @db.VarChar(32)
  eventType   String   @map("event_type") @db.VarChar(80)
  title       String   @db.VarChar(240)
  description String?  @db.VarChar(1000)
  eventAt     DateTime @map("event_at") @db.DateTime(3)
  source      String?  @db.VarChar(80)
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at") @db.DateTime(3)
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  brand       Brand?   @relation(fields: [brandId], references: [id], onDelete: SetNull)

  @@index([customerId, eventAt])
  @@index([brandId, eventAt])
  @@map("customer_journey_events")
}

model CustomerHqLink {
  id             String    @id @default(cuid()) @db.VarChar(32)
  customerId     String    @map("customer_id") @db.VarChar(32)
  brandId        String    @map("brand_id") @db.VarChar(32)
  externalSystem String    @map("external_system") @db.VarChar(80)
  externalId     String    @map("external_contact_id") @db.VarChar(191)
  linkStatus     String    @default("NOT_SYNCED") @map("sync_status") @db.VarChar(32)
  syncMethod     String?   @map("sync_method") @db.VarChar(80)
  lastSyncedAt   DateTime? @map("last_synced_at") @db.DateTime(3)
  lastError      String?   @map("last_error") @db.VarChar(1000)
  metadata       Json?
  createdAt      DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.DateTime(3)
  customer       Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  brand          Brand     @relation(fields: [brandId], references: [id], onDelete: Restrict)

  @@unique([customerId, brandId, externalSystem, externalId])
  @@index([externalSystem, externalId])
  @@map("customer_hq_links")
}

model IntegrationOutbox {
  id             String       @id @default(cuid()) @db.VarChar(32)
  aggregateType  String       @map("entity_type") @db.VarChar(64)
  aggregateId    String       @map("entity_id") @db.VarChar(32)
  brandId        String       @map("brand_id") @db.VarChar(32)
  integration    String       @default("SOWIND_GATEWAY") @db.VarChar(80)
  eventType      String       @map("event_type") @db.VarChar(100)
  idempotencyKey String       @unique @map("idempotency_key") @db.VarChar(191)
  payload        Json         @map("payload_snapshot_json")
  status         OutboxStatus @default(PENDING)
  attempts       Int          @default(0)
  nextAttemptAt  DateTime     @default(now()) @map("next_retry_at") @db.DateTime(3)
  lockedAt       DateTime?    @map("locked_at") @db.DateTime(3)
  lockOwner      String?      @map("lock_owner") @db.VarChar(64)
  leaseUntil     DateTime?    @map("lease_until") @db.DateTime(3)
  lastHttpStatus Int?         @map("last_http_status")
  lastResponse   Json?        @map("last_response_json")
  lastError      String?      @map("last_error") @db.VarChar(1000)
  triggeredBy    String       @default("AUTO") @map("triggered_by") @db.VarChar(32)
  processedAt    DateTime?    @map("processed_at") @db.DateTime(3)
  createdAt      DateTime     @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.DateTime(3)
  brand          Brand        @relation(fields: [brandId], references: [id], onDelete: Restrict)

  @@index([status, nextAttemptAt])
  @@index([status, leaseUntil])
  @@index([aggregateType, aggregateId])
  @@map("integration_outbox")
}

model IntegrationAttempt {
  id              String   @id @default(cuid()) @db.VarChar(32)
  outboxId        String   @map("outbox_id") @db.VarChar(32)
  leadId          String   @map("lead_id") @db.VarChar(32)
  attemptNumber   Int      @map("attempt_number")
  endpoint        String   @db.VarChar(500)
  brandCode       String   @map("brand") @db.VarChar(32)
  httpStatus      Int?     @map("http_status")
  gatewayRef      String?  @map("gateway_ref") @db.VarChar(191)
  triggeredBy     String   @default("AUTO") @map("triggered_by") @db.VarChar(32)
  requestSnapshot Json?    @map("request_snapshot_json")
  responseJson    Json?    @map("response_json")
  errorCode       String?  @map("error_code") @db.VarChar(120)
  errorMessage    String?  @map("error_message") @db.VarChar(1000)
  startedAt       DateTime @map("started_at") @db.DateTime(3)
  completedAt     DateTime @map("completed_at") @db.DateTime(3)
  durationMs      Int      @map("duration_ms")
  createdAt       DateTime @default(now()) @map("created_at") @db.DateTime(3)

  @@index([outboxId])
  @@index([leadId])
  @@map("integration_attempts")
}

model Contact {
  id               String            @id @default(cuid()) @db.VarChar(32)
  contactName      String            @map("contact_name") @db.VarChar(160)
  companyShortName String?           @map("company_short_name") @db.VarChar(120)
  companyName      String?           @map("company_name") @db.VarChar(240)
  department       String?           @db.VarChar(160)
  title            String?           @db.VarChar(160)
  email            String?           @db.VarChar(191)
  phone            String?           @db.VarChar(64)
  wechat           String?           @db.VarChar(191)
  linkedin         String?           @db.VarChar(500)
  website          String?           @db.VarChar(500)
  industry         String?           @db.VarChar(160)
  source           String?           @db.VarChar(160)
  country          String?           @db.VarChar(120)
  city             String?           @db.VarChar(120)
  region           String?           @db.VarChar(120)
  stage            CrmContactStage   @default(INITIAL)
  ownerUserId      String?           @map("owner_user_id") @db.VarChar(32)
  nextFollowupAt   DateTime?         @map("next_followup_at") @db.DateTime(3)
  initialContext   String?           @map("initial_context") @db.Text
  remark           String?           @db.Text
  createdAt        DateTime          @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.DateTime(3)
  createdByUserId  String            @map("created_by_user_id") @db.VarChar(32)
  owner            User?             @relation("ContactOwner", fields: [ownerUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdBy        User              @relation("ContactCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  followups        ContactFollowup[]
  leads            CrmLead[]

  @@index([stage, updatedAt])
  @@index([ownerUserId, updatedAt])
  @@index([nextFollowupAt])
  @@map("contacts")
}

model ContactFollowup {
  id              String          @id @default(cuid()) @db.VarChar(32)
  contactId       String          @map("contact_id") @db.VarChar(32)
  occurredAt      DateTime        @map("occurred_at") @db.DateTime(3)
  ownerUserId     String          @map("owner_user_id") @db.VarChar(32)
  type            CrmFollowupType @default(GENERAL)
  content         String          @db.Text
  createdAt       DateTime        @default(now()) @map("created_at") @db.DateTime(3)
  createdByUserId String          @map("created_by_user_id") @db.VarChar(32)
  contact         Contact         @relation(fields: [contactId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  owner           User            @relation("ContactFollowupOwner", fields: [ownerUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdBy       User            @relation("ContactFollowupCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([contactId, occurredAt])
  @@map("contact_followups")
}

model CrmLead {
  id                  String          @id @default(cuid()) @db.VarChar(32)
  contactId           String          @map("contact_id") @db.VarChar(32)
  requirementSummary  String          @map("requirement_summary") @db.VarChar(200)
  requirementDetail   String?         @map("requirement_detail") @db.Text
  latestProgress      String?         @map("latest_progress") @db.Text
  priority            CrmLeadPriority @default(MEDIUM)
  estimatedQuote      Decimal?        @map("estimated_quote") @db.Decimal(18, 2)
  currency            String?         @db.Char(3)
  projectDomain       String?         @map("project_domain") @db.VarChar(160)
  projectType         String?         @map("project_type") @db.VarChar(160)
  technologyType      String?         @map("technology_type") @db.VarChar(160)
  productType         String?         @map("product_type") @db.VarChar(160)
  productName         String?         @map("product_name") @db.VarChar(240)
  resourceRequirement String?         @map("resource_requirement") @db.Text
  solution            String?         @db.Text
  remark              String?         @db.Text
  status              CrmLeadStatus   @default(NEW)
  salesOwnerUserId    String?         @map("sales_owner_user_id") @db.VarChar(32)
  followupOwnerUserId String?         @map("followup_owner_user_id") @db.VarChar(32)
  nextFollowupAt      DateTime?       @map("next_followup_at") @db.DateTime(3)
  lastFollowupAt      DateTime?       @map("last_followup_at") @db.DateTime(3)
  createdAt           DateTime        @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt           DateTime        @updatedAt @map("updated_at") @db.DateTime(3)
  createdByUserId     String          @map("created_by_user_id") @db.VarChar(32)
  contact             Contact         @relation(fields: [contactId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  salesOwner          User?           @relation("CrmLeadSalesOwner", fields: [salesOwnerUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  followupOwner       User?           @relation("CrmLeadFollowupOwner", fields: [followupOwnerUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdBy           User            @relation("CrmLeadCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  followups           LeadFollowup[]

  @@index([contactId, updatedAt])
  @@index([status, updatedAt])
  @@index([priority, updatedAt])
  @@index([salesOwnerUserId, updatedAt])
  @@index([followupOwnerUserId, updatedAt])
  @@index([nextFollowupAt])
  @@index([lastFollowupAt])
  @@map("crm_leads")
}

model LeadFollowup {
  id              String          @id @default(cuid()) @db.VarChar(32)
  leadId          String          @map("lead_id") @db.VarChar(32)
  occurredAt      DateTime        @map("occurred_at") @db.DateTime(3)
  ownerUserId     String          @map("owner_user_id") @db.VarChar(32)
  type            CrmFollowupType @default(GENERAL)
  content         String          @db.Text
  important       Boolean         @default(false)
  createdAt       DateTime        @default(now()) @map("created_at") @db.DateTime(3)
  createdByUserId String          @map("created_by_user_id") @db.VarChar(32)
  lead            CrmLead         @relation(fields: [leadId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  owner           User            @relation("LeadFollowupOwner", fields: [ownerUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdBy       User            @relation("LeadFollowupCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([leadId, occurredAt])
  @@map("lead_followups")
}

model AuditLog {
  id          String   @id @default(cuid()) @db.VarChar(32)
  actorUserId String?  @map("actor_user_id") @db.VarChar(32)
  actorName   String   @map("actor_name") @db.VarChar(120)
  action      String   @db.VarChar(100)
  module      String   @db.VarChar(64)
  targetType  String   @map("target_type") @db.VarChar(64)
  targetId    String?  @map("target_id") @db.VarChar(64)
  brandId     String?  @map("brand_id") @db.VarChar(32)
  details     Json?
  ipAddress   String?  @map("ip_address") @db.VarChar(64)
  requestId   String?  @map("request_id") @db.VarChar(64)
  userAgent   String?  @map("user_agent") @db.VarChar(500)
  traceId     String?  @map("trace_id") @db.VarChar(64)
  createdAt   DateTime @default(now()) @map("created_at") @db.DateTime(3)

  @@index([createdAt])
  @@index([actorUserId, createdAt])
  @@index([module, createdAt])
  @@index([traceId])
  @@index([targetType, targetId])
  @@index([brandId, createdAt])
  @@map("audit_logs")
}

model ImportJob {
  id                  String         @id @default(cuid()) @db.VarChar(32)
  jobNo               String         @unique @map("job_no") @db.VarChar(80)
  objectType          String         @map("object_type") @db.VarChar(40)
  brandId             String?        @map("brand_id") @db.VarChar(32)
  subtype             String?        @db.VarChar(80)
  fileName            String         @map("file_name") @db.VarChar(255)
  storagePath         String?        @map("storage_path") @db.VarChar(500)
  fileHash            String?        @map("file_hash") @db.Char(64)
  mappingJson         Json?          @map("mapping_json")
  resultJson          Json?          @map("result_json")
  conflictStrategy    String?        @map("conflict_strategy") @db.VarChar(40)
  unmatchedStrategy   String?        @map("unmatched_strategy") @db.VarChar(40)
  status              JobStatus      @default(PENDING)
  totalCount          Int            @default(0) @map("total_count")
  importableCount     Int            @default(0) @map("importable_count")
  successCount        Int            @default(0) @map("success_count")
  failedCount         Int            @default(0) @map("failed_count")
  skippedCount        Int            @default(0) @map("skipped_count")
  createdCount        Int            @default(0) @map("created_count")
  updatedCount        Int            @default(0) @map("updated_count")
  failureFilePath     String?        @map("failure_file_path") @db.VarChar(500)
  createdBy           String         @map("created_by") @db.VarChar(32)
  createdAt           DateTime       @default(now()) @map("created_at") @db.DateTime(3)
  preflightedAt       DateTime?      @map("preflighted_at") @db.DateTime(3)
  processingStartedAt DateTime?      @map("processing_started_at") @db.DateTime(3)
  completedAt         DateTime?      @map("completed_at") @db.DateTime(3)
  brand               Brand?         @relation(fields: [brandId], references: [id], onDelete: Restrict)
  rows                ImportJobRow[]

  @@index([brandId, objectType, createdAt])
  @@index([createdBy, createdAt])
  @@index([brandId, objectType, fileHash])
  @@map("import_jobs")
}

model ImportJobRow {
  id                 String    @id @default(cuid()) @db.VarChar(32)
  importJobId        String    @map("import_job_id") @db.VarChar(32)
  rowNumber          Int       @map("row_number")
  status             String    @db.VarChar(32)
  conflictType       String?   @map("conflict_type") @db.VarChar(64)
  identity           String?   @db.VarChar(191)
  rawData            Json      @map("raw_data")
  normalizedData     Json?     @map("normalized_data")
  errors             Json?
  warnings           Json?
  resolvedCustomerId String?   @map("resolved_customer_id") @db.VarChar(32)
  resolvedProfileId  String?   @map("resolved_profile_id") @db.VarChar(32)
  resolvedLeadId     String?   @map("resolved_lead_id") @db.VarChar(32)
  createdId          String?   @map("created_id") @db.VarChar(32)
  createdAt          DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  importJob          ImportJob @relation(fields: [importJobId], references: [id], onDelete: Cascade)

  @@unique([importJobId, rowNumber])
  @@index([status])
  @@map("import_job_rows")
}

model ExportJob {
  id              String    @id @default(cuid()) @db.VarChar(32)
  jobNo           String    @unique @map("job_no") @db.VarChar(80)
  objectType      String    @map("object_type") @db.VarChar(40)
  brandId         String?   @map("brand_id") @db.VarChar(32)
  status          JobStatus @default(PENDING)
  requestJson     Json      @map("request_json")
  scope           String    @default("ALL") @db.VarChar(32)
  filterJson      Json?     @map("filter_json")
  selectedCount   Int       @default(0) @map("selected_count")
  requestedFields Json?     @map("requested_fields")
  effectiveFields Json?     @map("effective_fields")
  brandScope      Json?     @map("brand_scope")
  fileName        String?   @map("file_name") @db.VarChar(255)
  storagePath     String?   @map("storage_path") @db.VarChar(500)
  rowCount        Int       @default(0) @map("row_count")
  error           String?   @db.VarChar(1000)
  createdBy       String    @map("created_by") @db.VarChar(32)
  createdAt       DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  completedAt     DateTime? @map("completed_at") @db.DateTime(3)
  expiresAt       DateTime? @map("expires_at") @db.DateTime(3)
  brand           Brand?    @relation(fields: [brandId], references: [id], onDelete: Restrict)

  @@index([createdBy, createdAt])
  @@index([brandId, objectType, createdAt])
  @@map("export_jobs")
}

model IntegrationNonce {
  id        String   @id @default(cuid()) @db.VarChar(32)
  clientId  String   @map("client_id") @db.VarChar(120)
  nonce     String   @db.VarChar(191)
  expiresAt DateTime @map("expires_at") @db.DateTime(3)
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)

  @@unique([clientId, nonce])
  @@index([expiresAt])
  @@map("integration_nonces")
}
