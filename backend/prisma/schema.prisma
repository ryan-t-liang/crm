  entityId         String                       @map("entity_id") @db.VarChar(32)
  entityLabel      String                       @map("entity_label") @db.VarChar(300)
  fieldKey         String                       @map("field_key") @db.VarChar(80)
  fromUserId       String?                      @map("from_user_id") @db.VarChar(32)
  toUserId         String                       @map("to_user_id") @db.VarChar(32)
  assignedByUserId String                       @map("assigned_by_user_id") @db.VarChar(32)
  recipientEmail   String                       @map("recipient_email") @db.VarChar(191)
  payload          Json
  status           AssignmentNotificationStatus @default(PENDING)
  attempts         Int                          @default(0) @db.UnsignedSmallInt
  lastError        String?                      @map("last_error") @db.VarChar(1000)
  nextAttemptAt    DateTime?                    @map("next_attempt_at") @db.DateTime(3)
  sentAt           DateTime?                    @map("sent_at") @db.DateTime(3)
